NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin used by canonical/hreflang, sitemap.xml and robots.txt.
# Leave it unset to use the project's public site.
NEXT_PUBLIC_SITE_URL=

# Bearer token Vercel Cron sends to /api/v1/maintenance/module-jobs, which runs
# the scheduled jobs modules declare. Without it the endpoint answers 503.
MAINTENANCE_CRON_SECRET=
