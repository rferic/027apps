<?xml version="1.0" encoding="utf-8"?>
<!-- Debug launcher foreground: the real logo plus a "DEV" pill inside the
     adaptive icon's safe zone, so the test install is obvious at a glance. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_foreground" />
    <item
        android:width="46dp"
        android:height="14dp"
        android:gravity="bottom|center_horizontal"
        android:bottom="10dp">
        <bitmap
            android:src="@drawable/ic_launcher_dev_badge"
            android:gravity="fill" />
    </item>
</layer-list>
