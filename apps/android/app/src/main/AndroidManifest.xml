<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phone migration: only the new phone scans the QR, never in the background. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Self-update: the app hands the downloaded APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".Zero27AppsApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:theme="@style/Theme.Zero27Apps">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true"
            android:theme="@style/Theme.Zero27Apps.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Fallback for any instance: the app's own scheme. `zero27apps`
                 is browser-valid (a scheme cannot start with a digit), so the
                 web "Open in the app" can use it; the old `027apps` stays for
                 links and adb commands that already exist. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zero27apps" android:host="invite" />
                <data android:scheme="027apps" android:host="invite" />
                <!-- Phone migration: the web landing and the old phone's QR hand
                     the one-shot code to the new phone. -->
                <data android:scheme="zero27apps" android:host="migrate" />
                <data android:scheme="027apps" android:host="migrate" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <receiver
            android:name=".widget.OweWidgetReceiver"
            android:exported="true"
            android:label="@string/owe_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/owe_widget_info" />
        </receiver>

        <service
            android:name=".PushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
