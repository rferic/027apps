{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://027apps.local/schemas/manifest.schema.json",
  "title": "027Apps module manifest",
  "description": "Contract for packages/<key>/manifest.json. See docs/ai/module-system.md.",
  "x-manifest-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "name", "branding", "version", "docs"],
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "not": { "enum": ["admin", "mcp", "api", "core"] }
    },
    "name": { "type": "string", "minLength": 1 },
    "branding": { "$ref": "#/$defs/branding" },
    "version": { "$ref": "#/$defs/semver" },
    "is_public": { "type": "boolean", "default": false },
    "migraciones": { "type": "array", "items": { "$ref": "#/$defs/migration" } },
    "settings": { "type": "array", "items": { "$ref": "#/$defs/settingsCategory" } },
    "i18n": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "uniqueItems": true
    },
    "scopes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_-]+:[a-z0-9_-]+$" },
      "uniqueItems": true
    },
    "mcp_tools": { "type": "array", "items": { "$ref": "#/$defs/mcpTool" } },
    "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
    "eventos": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "hooks": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "admin_pages": { "type": "array", "items": { "$ref": "#/$defs/adminPage" } },
    "docs": { "$ref": "#/$defs/docs" }
  },
  "allOf": [
    {
      "if": { "required": ["scopes"] },
      "then": { "required": ["docs"], "properties": { "docs": { "required": ["api"] } } }
    },
    {
      "if": { "required": ["mcp_tools"] },
      "then": { "required": ["docs"], "properties": { "docs": { "required": ["mcp"] } } }
    },
    {
      "if": { "required": ["settings"] },
      "then": { "required": ["docs"], "properties": { "docs": { "required": ["settings"] } } }
    },
    {
      "if": { "anyOf": [{ "required": ["eventos"] }, { "required": ["channels"] }] },
      "then": { "required": ["docs"], "properties": { "docs": { "required": ["events"] } } }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-.]+)?(\\+[0-9A-Za-z-.]+)?$"
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "icon", "color"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "pattern": "^assets/.+\\.svg$" },
        "color": {
          "type": "string",
          "enum": ["teal", "indigo", "violet", "amber", "rose", "emerald", "sky", "slate"]
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "up", "down", "digest", "down_digest"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "up": { "type": "string", "minLength": 1 },
        "down": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "down_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "settingsCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "label", "icon", "sort_order", "settings"],
      "properties": {
        "category": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "label": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "minLength": 1 },
        "sort_order": { "type": "integer", "minimum": 0 },
        "settings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/setting" }
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "default",
        "label",
        "help",
        "is_public",
        "is_secret",
        "mcp_access",
        "sort_order"
      ],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "type": { "type": "string", "minLength": 1 },
        "default": {},
        "label": { "type": "string", "minLength": 1 },
        "help": { "type": "string", "minLength": 1 },
        "is_public": { "type": "boolean" },
        "is_secret": { "type": "boolean" },
        "mcp_access": { "type": "string", "enum": ["read", "write", "none"] },
        "sort_order": { "type": "integer", "minimum": 0 }
      }
    },
    "mcpTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "description", "scopes"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "kind": { "type": "string", "enum": ["read", "write"] },
        "description": { "type": "string", "minLength": 1 },
        "scopes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "members_fn"],
      "properties": {
        "pattern": { "type": "string", "minLength": 1 },
        "members_fn": { "type": "string", "minLength": 1 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "target": { "type": "string", "pattern": "^(admins|all|user|channel:.+)$" },
        "notify": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "adminPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "label", "icon", "group", "role"],
      "properties": {
        "route": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "enum": ["module"] },
        "role": { "type": "string", "enum": ["admin", "super_admin"] }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readme"],
      "properties": {
        "readme": { "type": "string", "minLength": 1 },
        "api": { "type": "string", "minLength": 1 },
        "mcp": { "type": "string", "minLength": 1 },
        "settings": { "type": "string", "minLength": 1 },
        "events": { "type": "string", "minLength": 1 }
      }
    }
  }
}
