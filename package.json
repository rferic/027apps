{
  "name": "027apps",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "tsc": "pnpm -r --if-present run tsc",
    "test": "pnpm -r --if-present run test",
    "check:openapi": "node scripts/check-openapi.mjs",
    "i18n:scan": "pnpm --filter @027apps/i18n scan",
    "i18n:check": "pnpm --filter @027apps/i18n check",
    "check:destructive-db": "bash scripts/check-destructive-db.sh",
    "db:backup": "bash scripts/db-local-backup.sh",
    "db:reset": "bash scripts/db-reset-local.sh",
    "db:restore": "bash scripts/db-local-restore.sh",
    "db:shim": "bash scripts/install-supabase-guard.sh",
    "qa:invitations": "bash scripts/qa-invitations.sh",
    "qa:android": "bash scripts/e2e-android-invite.sh",
    "qa:web": "pnpm --filter admin e2e",
    "qa:push": "bash scripts/qa-push.sh",
    "check:parity": "node scripts/check-parity.mjs"
  }
}
